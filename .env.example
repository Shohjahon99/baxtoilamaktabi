# Neon Postgres (Vercel → Storage → Neon ulanganda avtomatik qo'shiladi)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Kamida 32 belgili tasodifiy satr (masalan: openssl rand -hex 32)
SESSION_SECRET=""
# Bo'sh bo'lsa Vercel domeni ishlatiladi
APP_URL=""

TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# Click kalitlarini admin paneldagi «Click sozlama» dan ham kiritish mumkin
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""

# Admin panel (/admin) boshlang'ich login/paroli
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="kuchli-parol"

# Vercel Blob (Storage → Blob ulanganda avtomatik qo'shiladi) — admin rasm yuklashi uchun
BLOB_READ_WRITE_TOKEN=""

# Faqat lokal sinov uchun 1; serverda albatta 0
DEV_LOGIN="0"
